rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // InstaPay payment proof receipts uploaded by patients
    match /payment-receipts/{receiptId} {
      // Patients can upload image receipts (< 5MB, image/*)
      allow create: if request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      // Only authenticated admin can read or delete receipts
      allow read, delete: if request.auth != null;
    }

    // Clinic assets (QR codes, doctor profile, clinic photos)
    match /clinic-assets/{assetId} {
      // Anyone can read public clinic images/QR codes
      allow read: if true;
      // Only admin can upload/manage
      allow write: if request.auth != null;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
