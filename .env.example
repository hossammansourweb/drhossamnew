# ==========================================
# Firebase Configuration for د. حسام منصور أبوكل Medical Booking
# ==========================================
# قم بنسخ هذه القيم إلى ملف .env في مجلد المشروع الرئيسي
# Copy these values into a .env file at the project root

VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"

# Optional: Default Admin Email if needed
VITE_ADMIN_DEFAULT_EMAIL="admin@clinic.com"

# ==========================================
# Telegram Bot Notifications (SERVER-ONLY — never use VITE_ prefix)
# ==========================================
# The bot token must stay on the server. Never expose it in frontend code.
# Set these in your hosting provider's environment variables + local .env
# (.env is gitignored and never committed).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID="-1004430134261"
